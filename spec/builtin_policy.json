{
  "version": 2,
  "description": "0.2 出厂硬拦截。两级：BLOCK（不弹窗、不发请求）与 ALLOW（正常弹窗）。规则闭集，每一条都是「这种内容不该弹窗」；勾选启用、取消勾选关闭，locked 为 true 的项不允许关闭。",
  "rules": {
    "empty": {
      "label": "空输入",
      "level": "BLOCK",
      "locked": true,
      "detector": "text_is_blank",
      "description": "没有任何可解释的对象；纯图片不算空输入"
    },
    "no_letters": {
      "label": "没有文字",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "no_letters",
      "description": "纯数字、纯标点、纯符号或 emoji，没有可查的词"
    },
    "single_latin": {
      "label": "单个英文字母",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "single_latin",
      "description": "只复制到一个字母（a、x、I）；单个汉字不在此列，查字是真实需求"
    },
    "url": {
      "label": "只是一个网址",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "url",
      "description": "整段就是一个链接；句子中间夹链接不会命中"
    },
    "path": {
      "label": "只是一个路径",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "path_like",
      "description": "/usr/bin、C:\\Users\\…；命令里带路径（cd /usr/bin）不会命中"
    },
    "email": {
      "label": "只是一个邮箱",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "email",
      "description": "整段就是一个邮箱地址"
    },
    "filename": {
      "label": "只是一个文件名",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "filename",
      "description": "config.py 这类无空格、带已知后缀的文件名"
    },
    "token_blob": {
      "label": "像密钥或哈希的长串",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "token_blob",
      "description": "单段 32 字符以上且含数字：UUID、JWT、十六进制哈希、base64 密钥"
    },
    "fake_word": {
      "label": "乱码单词",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "fake_word",
      "description": "同一字符重复（aaaa）或 13 个以上连续辅音，没有可解释的词义"
    },
    "secret": {
      "label": "疑似密码或密钥",
      "level": "BLOCK",
      "locked": false,
      "detector": "feature",
      "feature": "secret_hint",
      "description": "password / api_key / 私钥 / otpauth / 验证码；多行代码里的示例写法仍然豁免",
      "multiline_code_exempt": true
    },
    "too_long": {
      "label": "超过 2000 字符",
      "level": "BLOCK",
      "locked": true,
      "detector": "threshold",
      "feature": "char_count",
      "threshold": "text_max_chars",
      "description": "绝对长度上限，按字符总数计算（含数字、标点、emoji），防止误操作烧掉 token"
    },
    "duplicate": {
      "label": "重复内容",
      "level": "BLOCK",
      "locked": false,
      "detector": "dedup",
      "description": "短时间内重复复制同一内容：静默跳过，不弹窗也不报错"
    }
  },
  "notices": {
    "description": "只作说明、不参与判定：长度与形态提醒不再弹窗，改为初判界面上的一行文字。",
    "items": [
      {
        "id": "word_too_long",
        "threshold": "word_max_len",
        "text": "英文单词超过长度上限"
      },
      {
        "id": "phrase_too_long",
        "threshold": "phrase_max_words",
        "text": "英文短语超过词数上限"
      },
      {
        "id": "chinese_too_long",
        "threshold": "cn_pure_max",
        "text": "中文术语超过长度上限"
      },
      {
        "id": "chinese_sentence_too_long",
        "threshold": "cn_sentence_max",
        "text": "中文语句超过长度上限"
      },
      {
        "id": "chinese_question_too_long",
        "threshold": "cn_question_max",
        "text": "中文疑问超过长度上限"
      },
      {
        "id": "chinese_paragraph_too_long",
        "threshold": "cn_paragraph_max",
        "text": "中文段落超过长度上限"
      },
      {
        "id": "english_sentence",
        "threshold": null,
        "text": "英文整句不拦截（0.1 的硬拦截已废弃）"
      }
    ]
  },
  "levels": {
    "BLOCK": {
      "popup": false,
      "request": false,
      "log": true
    },
    "ALLOW": {
      "popup": true,
      "request": true,
      "log": false
    }
  }
}

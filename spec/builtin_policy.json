{
  "version": 1,
  "description": "0.2 出厂拦截策略。level 可为 BLOCK / WARN / CONFIRM / ALLOW；locked 为 true 时设置页不允许下调。",
  "rules": {
    "empty": {
      "level": "BLOCK",
      "locked": true,
      "detector": "text_is_blank",
      "feature": null,
      "description": "空输入或纯空白，没有可解释的对象"
    },
    "url": {
      "level": "WARN",
      "locked": false,
      "detector": "regex",
      "feature": "url",
      "pattern": "^(?:https?|ftp|file)://\\S+$",
      "description": "URL 链接；用户可能想总结网页"
    },
    "email": {
      "level": "WARN",
      "locked": false,
      "detector": "regex",
      "feature": "email",
      "pattern": "^[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+$",
      "description": "邮箱地址；用户可能想翻译或分析邮件"
    },
    "drive": {
      "level": "WARN",
      "locked": false,
      "detector": "regex",
      "feature": "drive",
      "pattern": "^[A-Za-z]:[\\\\/]",
      "description": "Windows 盘符路径"
    },
    "path": {
      "level": "WARN",
      "locked": false,
      "detector": "feature",
      "feature": "path_like",
      "description": "POSIX 路径或反斜杠路径（含 / 或 \\）"
    },
    "filename": {
      "level": "WARN",
      "locked": false,
      "detector": "feature",
      "feature": "filename",
      "description": "无空格、后缀在词表或 mime 可猜；排除缩写与强代码符号"
    },
    "secret": {
      "level": "CONFIRM",
      "locked": false,
      "detector": "feature",
      "feature": "secret_hint",
      "description": "疑似密钥/口令/私钥/验证码；多行代码块豁免",
      "multiline_code_exempt": true
    },
    "fake_word": {
      "level": "WARN",
      "locked": false,
      "detector": "feature",
      "feature": "fake_word",
      "description": "重复字符或无元音超长串"
    },
    "word_too_long": {
      "level": "WARN",
      "locked": false,
      "detector": "threshold",
      "feature": "letters",
      "threshold": "word_max_len",
      "applies_when": {"feature": "is_word", "op": "eq", "value": true},
      "description": "英文单词超过长度上限"
    },
    "phrase_too_long": {
      "level": "WARN",
      "locked": false,
      "detector": "threshold",
      "feature": "word_count",
      "threshold": "phrase_max_words",
      "applies_when": {"feature": "is_phrase", "op": "eq", "value": true},
      "description": "英文短语超过词数上限"
    },
    "chinese_too_long": {
      "level": "WARN",
      "locked": false,
      "detector": "threshold",
      "feature": "letters",
      "threshold": "cn_pure_max",
      "applies_when": {"feature": "cn_term_like", "op": "eq", "value": true},
      "description": "中文术语超过长度上限（句子/段落/疑问各走独立规则）"
    },
    "chinese_sentence_too_long": {
      "level": "WARN",
      "locked": false,
      "detector": "threshold",
      "feature": "letters",
      "threshold": "cn_sentence_max",
      "applies_when": {"feature": "cn_sentence_only", "op": "eq", "value": true},
      "description": "中文语句超过长度上限（提示而非静默拦截，可升格为段落）"
    },
    "chinese_question_too_long": {
      "level": "WARN",
      "locked": false,
      "detector": "threshold",
      "feature": "letters",
      "threshold": "cn_question_max",
      "applies_when": {"feature": "cn_question", "op": "eq", "value": true},
      "description": "中文疑问句超过长度上限"
    },
    "chinese_paragraph_too_long": {
      "level": "WARN",
      "locked": false,
      "detector": "threshold",
      "feature": "letters",
      "threshold": "cn_paragraph_max",
      "applies_when": {"feature": "cn_paragraph_only", "op": "eq", "value": true},
      "description": "中文段落超过长度上限"
    },
    "english_sentence": {
      "level": "ALLOW",
      "locked": false,
      "detector": "feature",
      "feature": "en_sentence",
      "description": "0.1 的英文整句硬拦截，0.2 默认不拦截（修复 break the ice. 痛点）"
    },
    "too_long": {
      "level": "BLOCK",
      "locked": true,
      "detector": "threshold",
      "feature": "letters",
      "threshold": "code_block_max",
      "description": "绝对长度上限，防止一次剪贴板误操作烧掉 token"
    },
    "daily_limit": {
      "level": "BLOCK",
      "locked": true,
      "detector": "quota",
      "description": "每日请求配额耗尽"
    },
    "duplicate": {
      "level": "ALLOW",
      "locked": false,
      "detector": "dedup",
      "description": "重复内容；跳过而不报错"
    }
  },
  "levels": {
    "BLOCK": {"popup": false, "request": false, "log": true},
    "WARN": {"popup": true, "request": true, "log": false, "banner": true},
    "CONFIRM": {"popup": true, "request": true, "log": false, "confirm": true},
    "ALLOW": {"popup": true, "request": true, "log": false}
  }
}

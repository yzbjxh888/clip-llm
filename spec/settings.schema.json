{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clip-llm.local/schema/settings.schema.json",
  "title": "clip-llm 0.2 settings",
  "type": "object",
  "required": ["version", "trigger_policy"],
  "properties": {
    "version": {"type": "integer", "minimum": 2},
    "description": {"type": "string"},
    "trigger_policy": {"type": "string", "enum": ["auto", "confirm", "hotkey", "menu"]},
    "disabled_route_action": {"type": "string", "enum": ["block", "fallback", "hide_from_menu"]},
    "menu": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "show_other_domains": {"type": "boolean"},
        "show_disabled_items": {"type": "string", "enum": ["grayed", "hidden", "hidden_in_fold"]},
        "recommended_limit": {"type": "integer", "minimum": 1, "maximum": 9},
        "other_per_domain": {"type": "integer", "minimum": 0, "maximum": 9},
        "remember_last_intent": {"type": "boolean"},
        "default_intent_policy": {"type": "string", "enum": ["last_used", "first", "none"]},
        "auto_submit": {"type": "boolean"},
        "free_input_enabled": {"type": "boolean"},
        "format_toggle_enabled": {"type": "boolean"},
        "search_buttons_enabled": {"type": "boolean"},
        "show_copy_route": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "free_input": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["instruction", "prompt"]},
        "max_chars": {"type": "integer", "minimum": 1},
        "max_prompt_chars": {"type": "integer", "minimum": 1}
      }
    },
    "feature_switches": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "detection": {
      "type": "object",
      "properties": {
        "high": {"type": "number", "minimum": 0, "maximum": 1},
        "mid": {"type": "number", "minimum": 0, "maximum": 1},
        "gap": {"type": "number", "minimum": 0, "maximum": 1},
        "mixed_min_score": {"type": "number", "minimum": 0, "maximum": 1},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 9},
        "score_mode": {"type": "string", "enum": ["heuristic"]}
      }
    },
    "formats": {
      "type": "object",
      "properties": {
        "enabled": {"type": "array", "items": {"type": "string", "enum": ["static", "table", "interactive", "annotate"]}},
        "default": {"type": "string", "enum": ["static", "table", "interactive", "annotate"]}
      }
    },
    "image": {"type": "object"},
    "image_text_conflict": {"type": "string", "enum": ["image_only", "text_only", "mixed", "ask"]},
    "modality_window_ms": {"type": "integer", "minimum": 0, "maximum": 5000},
    "search_default_provider": {"type": "string"},
    "search_show_inline_buttons": {"type": "boolean"},
    "search_max_query_chars": {"type": "integer", "minimum": 1, "maximum": 2000},
    "daily_request_limit": {"type": "integer", "minimum": 0},
    "thresholds": {"type": "object", "additionalProperties": {"type": "integer"}},
    "domains": {"type": "array", "items": {"type": "object"}},
    "routes": {"type": "object", "additionalProperties": {"type": "object"}}
  }
}
